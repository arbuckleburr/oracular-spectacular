[
 {
  "id": "b15-01",
  "roll": null,
  "text": "Sparrows with sparrows and hornbills with hornbills.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-02",
  "roll": null,
  "text": "The pupil of the eye cannot be separated from the white.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-03",
  "roll": null,
  "text": "Fire when small is a friend, but when large it is an enemy.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-04",
  "roll": null,
  "text": "The rumour is better than the reality.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-05",
  "roll": null,
  "text": "Little fishes are the prey of large ones.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-06",
  "roll": null,
  "text": "If you pat a dog on the head, he wags his tail.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-07",
  "roll": null,
  "text": "It sometimes happens that the man who plants the cocoa-nut does not eat of its fruit.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-08",
  "roll": null,
  "text": "Whosoever digs a pit he shall fall into it himself.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-09",
  "roll": null,
  "text": "It is better to die with a good name than to live with a bad one.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-10",
  "roll": null,
  "text": "Stretch your legs according to the length of your blanket.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-11",
  "roll": null,
  "text": "The flower is worn in the ear, but the stalk is cast aside.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-12",
  "roll": null,
  "text": "From fear of losing a drop the whole is spilt.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-13",
  "roll": null,
  "text": "Kick away the ladder and the legs are left swinging.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-14",
  "roll": null,
  "text": "Where there are no eagles, the grasshoppers say we are eagles.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-15",
  "roll": null,
  "text": "To repent in time is gain, but to repent too late is useless.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-16",
  "roll": null,
  "text": "He who eats the jack-fruit will get his fingers sticky.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-17",
  "roll": null,
  "text": "The dead tree falls and the woodpecker perishes with it.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-18",
  "roll": null,
  "text": "If the nose is cut off the face is disfigured.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-19",
  "roll": null,
  "text": "If there is no wind the trees do not rock.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-20",
  "roll": null,
  "text": "Want of sense makes a man the slave of others.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-21",
  "roll": null,
  "text": "The eyes close in sleep, but the pillow remains awake.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-22",
  "roll": null,
  "text": "An elephant dies, but no one finds his trunk; a tiger dies, but no one finds his stripes.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-23",
  "roll": null,
  "text": "As is the number of men, so will be the number of purposes.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 },
 {
  "id": "b15-24",
  "roll": null,
  "text": "The mouth brings honey and the tail carries a sting.",
  "source": "Malay Proverbs (Maxwell)",
  "tradition": "Malay (Southeast Asia)",
  "era": "oral tradition, recorded 1878-83",
  "translator": "W. E. Maxwell, 1878-1883"
 }
]