[
 {
  "id": "b9-01",
  "roll": null,
  "text": "It is one man who kills an elephant, but many people who eat its flesh.",
  "source": "Ashanti Proverbs no. 106",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-02",
  "roll": null,
  "text": "No one knows what the elephant ate to make it big.",
  "source": "Ashanti Proverbs no. 110",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-03",
  "roll": null,
  "text": "When you have caught the mother hen, you pick up the chickens without difficulty.",
  "source": "Ashanti Proverbs no. 208",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-04",
  "roll": null,
  "text": "When a bird remains too long on a tree, it has a stone thrown at it.",
  "source": "Ashanti Proverbs no. 246",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-05",
  "roll": null,
  "text": "(The words from) the mouth of an old man are better than any amulet.",
  "source": "Ashanti Proverbs no. 392",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-06",
  "roll": null,
  "text": "One does not speak out one's mind in the presence of a chief, but behind his back one does.",
  "source": "Ashanti Proverbs no. 414",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-07",
  "roll": null,
  "text": "When a chief has plenty of milk, then all people drink of him.",
  "source": "Ashanti Proverbs no. 415",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-08",
  "roll": null,
  "text": "What one people talk and laugh about, another people talk and cry about.",
  "source": "Ashanti Proverbs no. 474",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-09",
  "roll": null,
  "text": "When you follow behind your father, you learn to walk like him.",
  "source": "Ashanti Proverbs no. 493",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-10",
  "roll": null,
  "text": "There is no medicine to cure hatred.",
  "source": "Ashanti Proverbs no. 579",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-11",
  "roll": null,
  "text": "' Friend, friend (I will tell you a secret),' that is how news spreads.",
  "source": "Ashanti Proverbs no. 584",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-12",
  "roll": null,
  "text": "When the fool is told a proverb, the meaning of it has to be explained to him.",
  "source": "Ashanti Proverbs no. 589",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-13",
  "roll": null,
  "text": "By the time the fool has learned to play the game, the players have dispersed.",
  "source": "Ashanti Proverbs no. 592",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-14",
  "roll": null,
  "text": "Poverty is like honey, it is not peculiar to one place alone.",
  "source": "Ashanti Proverbs no. 624",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-15",
  "roll": null,
  "text": "When a poor man makes a proverb, it does not spread abroad.",
  "source": "Ashanti Proverbs no. 631",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-16",
  "roll": null,
  "text": "If one could not make use of gold dust, then it would merely be called sand.",
  "source": "Ashanti Proverbs no. 649",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-17",
  "roll": null,
  "text": "Wealth is a fine thing, but to find an heir is not easy.",
  "source": "Ashanti Proverbs no. 658",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-18",
  "roll": null,
  "text": "Though rain beats on a stone it (the stone) stands firm where it stands.",
  "source": "Ashanti Proverbs no. 693",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-19",
  "roll": null,
  "text": "A knave for one is a good man for another.",
  "source": "Ashanti Proverbs no. 705",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-20",
  "roll": null,
  "text": "When one stands on another's shoulders, then he sees over the market.",
  "source": "Ashanti Proverbs no. 710",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-21",
  "roll": null,
  "text": "One cannot both feast and become rich.",
  "source": "Ashanti Proverbs no. 716",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-22",
  "roll": null,
  "text": "No one tests the depth of a river with both his feet.",
  "source": "Ashanti Proverbs no. 724",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-23",
  "roll": null,
  "text": "If one man does not know, another man explains.",
  "source": "Ashanti Proverbs no. 745",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-24",
  "roll": null,
  "text": "No one knows the story of to-morrow's dawn.",
  "source": "Ashanti Proverbs no. 746",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-25",
  "roll": null,
  "text": "It is a small thing that is taken to measure a big thing.",
  "source": "Ashanti Proverbs no. 758",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-26",
  "roll": null,
  "text": "When one would climb a tree, one begins from the bottom and not from the top.",
  "source": "Ashanti Proverbs no. 775",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-27",
  "roll": null,
  "text": "It is the path you do not fear that the wild beast catches you on.",
  "source": "Ashanti Proverbs no. 791",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-28",
  "roll": null,
  "text": "AVhen you do not know how to dance, then you say, ' The drum is not sounding sweetly'.",
  "source": "Ashanti Proverbs no. 807",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-29",
  "roll": null,
  "text": "A good case is not difficult to state.",
  "source": "Ashanti Proverbs no. 812",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 },
 {
  "id": "b9-30",
  "roll": null,
  "text": "No one dreams of going to where they will kill him.",
  "source": "Ashanti Proverbs no. 829",
  "tradition": "Ashanti (Akan, Ghana)",
  "era": "oral tradition, recorded 1916",
  "translator": "R. S. Rattray, 1916"
 }
]