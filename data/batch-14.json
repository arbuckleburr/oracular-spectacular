[
 {
  "id": "b14-01",
  "roll": null,
  "text": "The first story from the host, and tales till morning from the guest.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-02",
  "roll": null,
  "text": "The nurse is kissed for the sake of the child.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-03",
  "roll": null,
  "text": "A child is known by his manners.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-04",
  "roll": null,
  "text": "He that waits long at the ferry will get over some time.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-05",
  "roll": null,
  "text": "He who is always angry is of nature like the bramble.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-06",
  "roll": null,
  "text": "Every foot will tread on him who is in the mud.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-07",
  "roll": null,
  "text": "He who lies in the mud will rise dirty.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-08",
  "roll": null,
  "text": "The man that went farthest from home had as far to come back.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-09",
  "roll": null,
  "text": "He that promises most will perform least.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-10",
  "roll": null,
  "text": "He that goes among the briers must come out as best he can.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-11",
  "roll": null,
  "text": "He that hears badly will answer badly.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-12",
  "roll": null,
  "text": "He who hazards not will neither lose nor win.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-13",
  "roll": null,
  "text": "The fool of forty will never be wise.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-14",
  "roll": null,
  "text": "What will not wash will not wring.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-15",
  "roll": null,
  "text": "Short cuts often lead into mire.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-16",
  "roll": null,
  "text": "When the belly is full, then the eye waxes dull.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-17",
  "roll": null,
  "text": "A little hole will sink a big ship.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-18",
  "roll": null,
  "text": "Better no ring than a rush ring.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-19",
  "roll": null,
  "text": "The best apple is on the highest bough.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-20",
  "roll": null,
  "text": "The man of one cow will sometimes want milk.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-21",
  "roll": null,
  "text": "The moon is none the worse of the dogs’ barking at her.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-22",
  "roll": null,
  "text": "A clean corner is not the worse of being searched.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-23",
  "roll": null,
  "text": "A man laments not what he does not see.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-24",
  "roll": null,
  "text": "The friend in need is the only friend.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-25",
  "roll": null,
  "text": "Two never agreed at the kindling of a fire.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-26",
  "roll": null,
  "text": "The early riser will beat the late watcher.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 },
 {
  "id": "b14-27",
  "roll": null,
  "text": "The meanest person in the house brags most of his kindred.",
  "source": "Gaelic Proverbs (Nicolson)",
  "tradition": "Scottish Gaelic (Celtic)",
  "era": "oral tradition, recorded 1882",
  "translator": "Alexander Nicolson, 1882"
 }
]