[
 {
  "id": "b3-01",
  "roll": null,
  "text": "Now therefore he who hath ear to hear let him hear.",
  "source": "Pistis Sophia",
  "tradition": "Gnostic (Coptic)",
  "era": "3rd c. CE",
  "translator": "G. Horner, 1924"
 },
 {
  "id": "b3-02",
  "roll": null,
  "text": "Now therefore he who understandeth, let him understand.",
  "source": "Pistis Sophia",
  "tradition": "Gnostic (Coptic)",
  "era": "3rd c. CE",
  "translator": "G. Horner, 1924"
 },
 {
  "id": "b3-03",
  "roll": null,
  "text": "And he who has pleasure in the Living One, will himself become living.",
  "source": "Odes of Solomon",
  "tradition": "Early Christian-Gnostic (Syriac)",
  "era": "c. 100 CE",
  "translator": "J. Rendel Harris, 1911"
 },
 {
  "id": "b3-04",
  "roll": null,
  "text": "For he that is joined to Him that is immortal, will also himself become immortal.",
  "source": "Odes of Solomon",
  "tradition": "Early Christian-Gnostic (Syriac)",
  "era": "c. 100 CE",
  "translator": "J. Rendel Harris, 1911"
 },
 {
  "id": "b3-05",
  "roll": null,
  "text": "Be wise and understanding and vigilant.",
  "source": "Odes of Solomon",
  "tradition": "Early Christian-Gnostic (Syriac)",
  "era": "c. 100 CE",
  "translator": "J. Rendel Harris, 1911"
 },
 {
  "id": "b3-06",
  "roll": null,
  "text": "The Glory of all things is God, Godhead and Godly Nature.",
  "source": "Corpus Hermeticum III",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-07",
  "roll": null,
  "text": "But where there’s passion, nowhere is there Good; and where is Good, nowhere a single passion.",
  "source": "Corpus Hermeticum VI",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-08",
  "roll": null,
  "text": "For where is day, nowhere is night; and where is night, day is nowhere.",
  "source": "Corpus Hermeticum VI",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-09",
  "roll": null,
  "text": "In God alone, is, therefore, Good, or rather Good is God Himself.",
  "source": "Corpus Hermeticum VI",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-10",
  "roll": null,
  "text": "Yea, understand the Cosmos is by God and in God; but Man by Cosmos and in Cosmos.",
  "source": "Corpus Hermeticum VIII",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-11",
  "roll": null,
  "text": "For Gnosis of the Good is holy silence and a giving holiday to every sense.",
  "source": "Corpus Hermeticum X",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-12",
  "roll": null,
  "text": "And the soul’s vice is ignorance.",
  "source": "Corpus Hermeticum X",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-13",
  "roll": null,
  "text": "Æon is, then, in God; Cosmos, in Æon; in Cosmos, Time; in Time, Becoming.",
  "source": "Corpus Hermeticum XI",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-14",
  "roll": null,
  "text": "For naught is like to That which hath no like, and is Alone and One.",
  "source": "Corpus Hermeticum XI",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-15",
  "roll": null,
  "text": "For where is Soul, there too is Mind; just as where Life, there is there also Soul.",
  "source": "Corpus Hermeticum XII",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-16",
  "roll": null,
  "text": "One Passion hath God only—Good; and He who’s Good, is neither arrogant nor impotent.",
  "source": "Corpus Hermeticum XIV",
  "tradition": "Hermetic (Greco-Egyptian)",
  "era": "1st-3rd c. CE",
  "translator": "G. R. S. Mead, 1906"
 },
 {
  "id": "b3-17",
  "roll": null,
  "text": "Who danceth not, knows not what is being done.",
  "source": "Hymn of Jesus (Acts of John)",
  "tradition": "Gnostic (Greek)",
  "era": "2nd c. CE",
  "translator": "G. R. S. Mead, 1907"
 },
 {
  "id": "b3-18",
  "roll": null,
  "text": "I am a lamp to thee who seest Me.",
  "source": "Hymn of Jesus (Acts of John)",
  "tradition": "Gnostic (Greek)",
  "era": "2nd c. CE",
  "translator": "G. R. S. Mead, 1907"
 },
 {
  "id": "b3-19",
  "roll": null,
  "text": "I am a mirror to thee who understandest Me.",
  "source": "Hymn of Jesus (Acts of John)",
  "tradition": "Gnostic (Greek)",
  "era": "2nd c. CE",
  "translator": "G. R. S. Mead, 1907"
 },
 {
  "id": "b3-20",
  "roll": null,
  "text": "I am a door to thee who knockest at Me.",
  "source": "Hymn of Jesus (Acts of John)",
  "tradition": "Gnostic (Greek)",
  "era": "2nd c. CE",
  "translator": "G. R. S. Mead, 1907"
 },
 {
  "id": "b3-21",
  "roll": null,
  "text": "I am a way to thee a wayfarer.",
  "source": "Hymn of Jesus (Acts of John)",
  "tradition": "Gnostic (Greek)",
  "era": "2nd c. CE",
  "translator": "G. R. S. Mead, 1907"
 },
 {
  "id": "b3-22",
  "roll": null,
  "text": "Keep silence on My Mysteries.",
  "source": "Hymn of Jesus (Acts of John)",
  "tradition": "Gnostic (Greek)",
  "era": "2nd c. CE",
  "translator": "G. R. S. Mead, 1907"
 }
]