[
 {
  "id": "b2-01",
  "roll": null,
  "text": "Be not proud because thou art learned; but discourse with the ignorant man, as with the sage.",
  "source": "Ptahhotep, Instruction, maxim 1",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-02",
  "roll": null,
  "text": "No limit can be set to skill, neither is there any craftsman that possesseth full advantages.",
  "source": "Ptahhotep, Instruction, maxim 1",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-03",
  "roll": null,
  "text": "Fair speech is more rare than the emerald that is found by slave-maidens on the pebbles.",
  "source": "Ptahhotep, Instruction, maxim 1",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-04",
  "roll": null,
  "text": "Great is Truth, appointing a straight path.",
  "source": "Ptahhotep, Instruction, maxim 5",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-05",
  "roll": null,
  "text": "Live, therefore, in the house of kindliness, and men shall come and give gifts of themselves.",
  "source": "Ptahhotep, Instruction, maxim 6",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-06",
  "roll": null,
  "text": "Silence is more profitable unto thee than abundance of speech.",
  "source": "Ptahhotep, Instruction, maxim 24",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-07",
  "roll": null,
  "text": "A cup of water quencheth the thirst, and a mouthful of melon supporteth the heart.",
  "source": "Kagemni, Instruction, maxim 2",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-08",
  "roll": null,
  "text": "The bowman hitteth the mark, as the steersman reacheth land, by diversity of aim.",
  "source": "Ptahhotep, Instruction, maxim 25",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-09",
  "roll": null,
  "text": "Vice must be drawn out, that virtue may remain.",
  "source": "Ptahhotep, Instruction, maxim 36",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-10",
  "roll": null,
  "text": "Quarrelling in place of friendship is a foolish thing.",
  "source": "Ptahhotep, Instruction, maxim 31",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-11",
  "roll": null,
  "text": "He that obeyeth becometh one obeyed.",
  "source": "Ptahhotep, Instruction, maxim 38",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-12",
  "roll": null,
  "text": "When riches are gained, follow the heart; for riches are of no avail if one be weary.",
  "source": "Ptahhotep, Instruction, maxim 11",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-13",
  "roll": null,
  "text": "Be not covetous toward thy neighbours; for with a gentle man praise availeth more than might.",
  "source": "Ptahhotep, Instruction, maxim 20",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-14",
  "roll": null,
  "text": "Heedlessness leadeth unto disobedience on the morrow; but understanding shall stablish him.",
  "source": "Ptahhotep, Instruction, maxim 39",
  "tradition": "Egyptian",
  "era": "c. 2400 BCE (traditional)",
  "translator": "Battiscombe G. Gunn, 1906"
 },
 {
  "id": "b2-15",
  "roll": null,
  "text": "A faithfull friend is a strong defence: and he that hath found such an one hath found a treasure.",
  "source": "Sirach (Ecclesiasticus) 6:14",
  "tradition": "Hebrew (Jewish)",
  "era": "c. 180 BCE",
  "translator": "King James Apocrypha, 1611"
 },
 {
  "id": "b2-16",
  "roll": null,
  "text": "If thou wouldest get a friend, prove him first and be not hasty to credit him.",
  "source": "Sirach (Ecclesiasticus) 6:7",
  "tradition": "Hebrew (Jewish)",
  "era": "c. 180 BCE",
  "translator": "King James Apocrypha, 1611"
 },
 {
  "id": "b2-17",
  "roll": null,
  "text": "A friend cannot be known in prosperity: and an enemy cannot be hidden in adversity.",
  "source": "Sirach (Ecclesiasticus) 12:8",
  "tradition": "Hebrew (Jewish)",
  "era": "c. 180 BCE",
  "translator": "King James Apocrypha, 1611"
 },
 {
  "id": "b2-18",
  "roll": null,
  "text": "If thou hast understanding, answer thy neighbour; if not, lay thy hand upon thy mouth.",
  "source": "Sirach (Ecclesiasticus) 5:12",
  "tradition": "Hebrew (Jewish)",
  "era": "c. 180 BCE",
  "translator": "King James Apocrypha, 1611"
 },
 {
  "id": "b2-19",
  "roll": null,
  "text": "He that can rule his tongue shall live without strife; and he that hateth babbling shall have less evil.",
  "source": "Sirach (Ecclesiasticus) 19:6",
  "tradition": "Hebrew (Jewish)",
  "era": "c. 180 BCE",
  "translator": "King James Apocrypha, 1611"
 },
 {
  "id": "b2-20",
  "roll": null,
  "text": "Better is he that laboureth, and aboundeth in all things, than he that boasteth himself, and wanteth bread.",
  "source": "Sirach (Ecclesiasticus) 10:27",
  "tradition": "Hebrew (Jewish)",
  "era": "c. 180 BCE",
  "translator": "King James Apocrypha, 1611"
 },
 {
  "id": "b2-21",
  "roll": null,
  "text": "Change not a friend for any good by no means; neither a faithful brother for the gold of Ophir.",
  "source": "Sirach (Ecclesiasticus) 7:18",
  "tradition": "Hebrew (Jewish)",
  "era": "c. 180 BCE",
  "translator": "King James Apocrypha, 1611"
 },
 {
  "id": "b2-22",
  "roll": null,
  "text": "Judge none blessed before his death: for a man shall be known in his children.",
  "source": "Sirach (Ecclesiasticus) 11:28",
  "tradition": "Hebrew (Jewish)",
  "era": "c. 180 BCE",
  "translator": "King James Apocrypha, 1611"
 },
 {
  "id": "b2-23",
  "roll": null,
  "text": "Consult not with a fool; for he cannot keep counsel.",
  "source": "Sirach (Ecclesiasticus) 8:17",
  "tradition": "Hebrew (Jewish)",
  "era": "c. 180 BCE",
  "translator": "King James Apocrypha, 1611"
 },
 {
  "id": "b2-24",
  "roll": null,
  "text": "When thou hast enough, remember the time of hunger: and when thou art rich, think upon poverty and need.",
  "source": "Sirach (Ecclesiasticus) 18:25",
  "tradition": "Hebrew (Jewish)",
  "era": "c. 180 BCE",
  "translator": "King James Apocrypha, 1611"
 },
 {
  "id": "b2-25",
  "roll": null,
  "text": "A soft answer turneth away wrath: but grievous words stir up anger.",
  "source": "Proverbs 15:1",
  "tradition": "Hebrew (Jewish)",
  "era": "10th-3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-26",
  "roll": null,
  "text": "A merry heart doeth good like a medicine: but a broken spirit drieth the bones.",
  "source": "Proverbs 17:22",
  "tradition": "Hebrew (Jewish)",
  "era": "10th-3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-27",
  "roll": null,
  "text": "He that is slow to anger is better than the mighty; and he that ruleth his spirit than he that taketh a city.",
  "source": "Proverbs 16:32",
  "tradition": "Hebrew (Jewish)",
  "era": "10th-3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-28",
  "roll": null,
  "text": "Iron sharpeneth iron; so a man sharpeneth the countenance of his friend.",
  "source": "Proverbs 27:17",
  "tradition": "Hebrew (Jewish)",
  "era": "10th-3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-29",
  "roll": null,
  "text": "Faithful are the wounds of a friend; but the kisses of an enemy are deceitful.",
  "source": "Proverbs 27:6",
  "tradition": "Hebrew (Jewish)",
  "era": "10th-3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-30",
  "roll": null,
  "text": "Go to the ant, thou sluggard; consider her ways, and be wise.",
  "source": "Proverbs 6:6",
  "tradition": "Hebrew (Jewish)",
  "era": "10th-3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-31",
  "roll": null,
  "text": "A good name is rather to be chosen than great riches.",
  "source": "Proverbs 22:1",
  "tradition": "Hebrew (Jewish)",
  "era": "10th-3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-32",
  "roll": null,
  "text": "Where there is no vision, the people perish.",
  "source": "Proverbs 29:18",
  "tradition": "Hebrew (Jewish)",
  "era": "10th-3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-33",
  "roll": null,
  "text": "To every thing there is a season, and a time to every purpose under the heaven.",
  "source": "Ecclesiastes 3:1",
  "tradition": "Hebrew (Jewish)",
  "era": "3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-34",
  "roll": null,
  "text": "Better is an handful with quietness, than both the hands full with travail and vexation of spirit.",
  "source": "Ecclesiastes 4:6",
  "tradition": "Hebrew (Jewish)",
  "era": "3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-35",
  "roll": null,
  "text": "Cast thy bread upon the waters: for thou shalt find it after many days.",
  "source": "Ecclesiastes 11:1",
  "tradition": "Hebrew (Jewish)",
  "era": "3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-36",
  "roll": null,
  "text": "A threefold cord is not quickly broken.",
  "source": "Ecclesiastes 4:12",
  "tradition": "Hebrew (Jewish)",
  "era": "3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-37",
  "roll": null,
  "text": "The race is not to the swift, nor the battle to the strong.",
  "source": "Ecclesiastes 9:11",
  "tradition": "Hebrew (Jewish)",
  "era": "3rd c. BCE",
  "translator": "King James Version, 1611"
 },
 {
  "id": "b2-38",
  "roll": null,
  "text": "Two are better than one; because they have a good reward for their labour.",
  "source": "Ecclesiastes 4:9",
  "tradition": "Hebrew (Jewish)",
  "era": "3rd c. BCE",
  "translator": "King James Version, 1611"
 }
]